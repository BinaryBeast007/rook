{
  "name": "@rook/monorepo",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/BinaryBeast007/rook#readme",
  "bugs": {
    "url": "https://github.com/BinaryBeast007/rook/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinaryBeast007/rook.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @rook/web --filter @rook/desktop dev",
    "build": "vp run -r build",
    "start": "vp run --filter @rook/desktop start",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run -r test",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp fmt --check && vp lint --deny-warnings && vp run -r --cache typecheck && node scripts/export-icons.mjs --check",
    "icons:export": "node scripts/export-icons.mjs",
    "icons:check": "node scripts/export-icons.mjs --check",
    "dist": "vp run build && vp run --filter @rook/desktop dist",
    "dist:win": "vp run build && vp run --filter @rook/desktop dist:win",
    "dist:mac": "vp run build && vp run --filter @rook/desktop dist:mac",
    "dist:linux": "vp run build && vp run --filter @rook/desktop dist:linux",
    "dist:linux:docker": "vp run --filter @rook/desktop dist:linux:docker"
  },
  "devDependencies": {
    "@resvg/resvg-js": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
